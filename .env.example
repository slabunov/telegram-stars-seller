# "debug" для разработки, "prod" для обычного использования
APP_ENV=debug

SITE_DOMAIN=https://example.ru
USE_SSL=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=секретный_ключ_для_django
FRAGMENT_WEBHOOK_SECRET=секретный_токен_для_fragment_вебхука

CELERY_BROKER_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN_DEBUG=токен_тестового_бота
TELEGRAM_BOT_TOKEN_PROD=токен_обычного_бота
TELEGRAM_ADMIN_CHAT_ID=id_админской_группы
TELEGRAM_ADMIN_BROADCAST_TOPIC_ID=id_топика_для_предпросмотра_рассылок
TELEGRAM_ADMIN_ORDERS_TOPIC_ID=id_топика_для_уведомлений_о_созданных_заказах
TELEGRAM_CHANNEL_ID=id_канала
TELEGRAM_CHANNEL_LINK=ссылка_на_канал
NOTIFY_ABOUT_ORDERS=False

SUPPORT_URL=url_поддержки
FEEDBACK_URL=url_где_можно_оставить_отзыв

FRAGMENT_API_URL=https://api.fragment-api.com/v1
FRAGMENT_CURRENCY=TON
# Как часто перечитывать статусы заказов Fragment
FRAGMENT_POLL_SECONDS=15
# Сколько часов после создания транзакции ещё опрашивать её заказ
FRAGMENT_POLL_MAX_AGE_HOURS=24
# Через сколько минут "зависший" заказ помечать как ПОД СОМНЕНИЕМ
FRAGMENT_POLL_DOUBT_AFTER_MINUTES=30

PLATEGA_API_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=данные_от_менеджера_или_из_ЛК
PLATEGA_SECRET=данные_от_менеджера_или_из_ЛК

PAYPEAR_API_URL=https://api.paypear.ru/v1
PAYPEAR_SHOP_ID=id_магазина_из_ЛК
PAYPEAR_SECRET=секрет_из_ЛК
# IP, с которых PayPear шлёт вебхуки (через запятую)
PAYPEAR_WEBHOOK_IPS=158.160.85.101